{
  "name": "leptovids",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "remotion studio src/index.ts",
    "build": "remotion bundle src/index.ts",
    "typecheck": "tsc --noEmit",
    "render:test": "remotion render src/index.ts LeptoFilm out/test.mp4 --codec h264",
    "test": "node --test test/*.cjs",
    "render:antibiotics": "remotion render src/index.ts AntibioticsFilm out/antibiotics.mp4 --codec h264",
    "render:mosquito": "remotion render src/index.ts MosquitoFilm out/mosquito.mp4 --codec h264",
    "audio:sfx": "node scripts/generate-sfx.mjs",
    "audio:narration": "node scripts/generate-narration.mjs"
  },
  "dependencies": {
    "@fontsource/noto-sans-thai": "5.3.0",
    "@remotion/cli": "4.0.529",
    "@remotion/renderer": "4.0.529",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remotion": "4.0.529"
  },
  "devDependencies": {
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "typescript": "5.9.3"
  }
}
